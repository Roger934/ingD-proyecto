# MySQL 8.4 — db2: RÉPLICA de db1 (D4)
# read_only/super_read_only NO van aquí: romperían la inicialización del contenedor.
# Los activa scripts/mysql/init-replica.sh con SET PERSIST.
[mysqld]
server_id                = 2
report_host              = db2
bind_address             = 0.0.0.0
port                     = 3306
skip_name_resolve        = ON

gtid_mode                = ON
enforce_gtid_consistency = ON
log_bin                  = binlog          # para poder promoverla a primario (failover)
binlog_format            = ROW
log_replica_updates      = ON
binlog_expire_logs_seconds = 3888000  # 45 días: un nodo reconstruido se pone al día desde el binlog
relay_log                = relay-bin

innodb_buffer_pool_size  = 256M
max_connections          = 200

character_set_server     = utf8mb4
collation_server         = utf8mb4_0900_ai_ci
