# Copia este archivo a .env (cp .env.example .env) y ajusta los valores.
# .env NUNCA se sube al repo.

# Contraseña del usuario admin de Grafana
GRAFANA_ADMIN_PASSWORD=cambia-esto

# IPs de cada rol. Deben coincidir con hosts/hosts.casa o hosts/hosts.uni.
# --- Casa ---
DB1_IP=192.168.1.101
DB2_IP=192.168.1.103
DB3_IP=192.168.1.102
APP_IP=192.168.1.101
# --- Uni (descomenta estas y comenta las de arriba) ---
# DB1_IP=192.168.1.104
# DB2_IP=192.168.1.105
# DB3_IP=192.168.1.103
# APP_IP=192.168.1.102
