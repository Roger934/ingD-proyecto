{
  "uid": "plataforma-compras",
  "title": "Plataforma — Compras",
  "description": "Compras de la API (Saga): ritmo por resultado, latencia, compensaciones, fallas por paso y primario actual de cada motor. Es la pantalla para correr el simulador y las pruebas de falla.",
  "tags": ["ingdatos"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API y vigilante",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"api\"}", "legendFormat": "API", "instant": true },
        { "refId": "B", "expr": "up{job=\"vigilante\"}", "legendFormat": "Vigilante", "instant": true }
      ],
      "options": {
        "colorMode": "background", "graphMode": "none", "textMode": "value_and_name",
        "justifyMode": "center", "orientation": "vertical",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "CAÍDO", "color": "red" }, "1": { "text": "ARRIBA", "color": "green" } } } ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Compras confirmadas por segundo",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(compras_total{resultado=\"confirmada\"}[$__rate_interval])) or vector(0)", "legendFormat": "confirmadas/s" }
      ],
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "value",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia p95 de una compra",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(compra_duracion_segundos_bucket{resultado=~\"confirmada|cancelada\"}[$__rate_interval])))", "legendFormat": "p95" }
      ],
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "value",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2, "noValue": "sin compras",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 2 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Primario MySQL",
      "gridPos": { "x": 15, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (nodo) (vigilante_es_primario{motor=\"mysql\"}) == 1", "legendFormat": "{{nodo}}", "instant": true }
      ],
      "options": {
        "colorMode": "background", "graphMode": "none", "textMode": "name",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "noValue": "SIN PRIMARIO", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Primario PostgreSQL",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (nodo) (vigilante_es_primario{motor=\"postgres\"}) == 1", "legendFormat": "{{nodo}}", "instant": true }
      ],
      "options": {
        "colorMode": "background", "graphMode": "none", "textMode": "name",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "noValue": "SIN PRIMARIO", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Compras por segundo, por resultado",
      "description": "confirmada: la Saga terminó · cancelada: se compensó (p. ej. sin stock) · rechazada: regla de negocio · error: falló un motor (503) · repetida: reintento con la misma Idempotency-Key",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (resultado) (rate(compras_total[$__rate_interval]))", "legendFormat": "{{resultado}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "confirmada" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "cancelada" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "rechazada" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "repetida" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia de una compra (p50, p95, p99)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(compra_duracion_segundos_bucket{resultado=~\"confirmada|cancelada\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(compra_duracion_segundos_bucket{resultado=~\"confirmada|cancelada\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(compra_duracion_segundos_bucket{resultado=~\"confirmada|cancelada\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Compensaciones y fallas por paso de la Saga (por minuto)",
      "description": "Compensaciones: liberar la reserva (PostgreSQL) o cancelar el pedido (MySQL). Fallas: el motor no respondió en ese paso.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (tipo, resultado) (rate(compensaciones_total[$__rate_interval])) * 60", "legendFormat": "compensación {{tipo}} ({{resultado}})" },
        { "refId": "B", "expr": "sum by (paso, motor) (rate(saga_fallas_total[$__rate_interval])) * 60", "legendFormat": "falla paso {{paso}} · {{motor}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Primario de cada motor (vigilante)",
      "description": "Quién es el primario en cada momento. Un cambio de color es un failover; el rojo es el tiempo sin primario.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (motor, nodo) (vigilante_es_primario) == 1", "legendFormat": "{{motor}} → {{nodo}}" },
        { "refId": "B", "expr": "max by (motor) (vigilante_sin_primario) == 1", "legendFormat": "{{motor}} SIN PRIMARIO" }
      ],
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false } },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "custom": { "fillOpacity": 80, "lineWidth": 0 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*SIN PRIMARIO" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Totales en el periodo de la gráfica",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(compras_total{resultado=\"confirmada\"}[$__range])) or vector(0)", "legendFormat": "Confirmadas", "instant": true },
        { "refId": "B", "expr": "sum(increase(compras_total{resultado=\"cancelada\"}[$__range])) or vector(0)", "legendFormat": "Compensadas", "instant": true },
        { "refId": "C", "expr": "sum(increase(compras_total{resultado=\"rechazada\"}[$__range])) or vector(0)", "legendFormat": "Rechazadas", "instant": true },
        { "refId": "D", "expr": "sum(increase(compras_total{resultado=\"error\"}[$__range])) or vector(0)", "legendFormat": "Errores (503)", "instant": true },
        { "refId": "E", "expr": "sum(increase(vigilante_failovers_total[$__range])) or vector(0)", "legendFormat": "Failovers", "instant": true },
        { "refId": "F", "expr": "sum(increase(vigilante_rejoins_total[$__range])) or vector(0)", "legendFormat": "Rejoins", "instant": true }
      ],
      "options": {
        "colorMode": "value", "graphMode": "none", "textMode": "value_and_name",
        "justifyMode": "center", "orientation": "vertical",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Confirmadas" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "Compensadas" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "Errores (503)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "Failovers" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      }
    }
  ]
}
