# MySQL 8.4 — db1: PRIMARIO (D4: primario-réplica con GTID)
[mysqld]
server_id                = 1
report_host              = db1
bind_address             = 0.0.0.0
port                     = 3306
skip_name_resolve        = ON

# Replicación por GTID
gtid_mode                = ON
enforce_gtid_consistency = ON
log_bin                  = binlog
binlog_format            = ROW
binlog_expire_logs_seconds = 604800   # 7 días

# Memoria: los datos son pocos (60k filas), no hace falta más
innodb_buffer_pool_size  = 256M
max_connections          = 200

character_set_server     = utf8mb4
collation_server         = utf8mb4_0900_ai_ci
